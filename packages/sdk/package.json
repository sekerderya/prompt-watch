{
  "name": "@promptwatch/sdk",
  "version": "0.1.0",
  "description": "Drop-in observability, versioning and A/B testing for LLM system prompts.",
  "keywords": [
    "llm",
    "openai",
    "observability",
    "prompt",
    "ab-testing",
    "telemetry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sekerderya/prompt-watch.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/sekerderya/prompt-watch#readme",
  "bugs": {
    "url": "https://github.com/sekerderya/prompt-watch/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "nock": "^14.0.17",
    "openai": "^4.104.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
