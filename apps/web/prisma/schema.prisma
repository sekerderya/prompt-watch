generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ABTestStatus {
  ACTIVE
  STOPPED
}

/// Where the prompt actually sent to the model came from.
enum PromptSource {
  /// The text in the caller's own code.
  LOCAL
  /// A version promoted in the dashboard (ADR-11).
  REGISTRY
  /// A variant assigned by a running A/B test.
  AB_TEST
}

/// How a version came to be the one served.
enum ReleaseSource {
  /// Promoted because it won an A/B test at significance.
  AB_TEST_WINNER
  /// Promoted by hand from the Prompts page.
  MANUAL
  /// Promoted back to an earlier version after a regression.
  ROLLBACK
}

enum TraceStatus {
  SUCCESS
  ERROR
}

/// Coarse failure categories. Derived by the SDK from the HTTP status and the
/// error's class name only — never from a message, so no user content can reach
/// telemetry through an error string (ADR-2).
enum TraceErrorType {
  RATE_LIMIT
  TIMEOUT
  AUTH
  INVALID_REQUEST
  NOT_FOUND
  CONTENT_FILTER
  SERVER
  NETWORK
  CANCELLED
  UNKNOWN
}

model Prompt {
  id         Int      @id @default(autoincrement())
  name       String
  version    Int
  promptText String   @map("prompt_text")
  promptHash String   @map("prompt_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  abTestsAsA ABTest[]      @relation("VariantA")
  abTestsAsB ABTest[]      @relation("VariantB")
  traces     Trace[]
  releases   PromptRelease[]

  @@unique([name, promptHash])
  @@unique([name, version])
  @@index([name])
  @@map("prompts")
}

model ABTest {
  id           Int          @id @default(autoincrement())
  name         String
  promptName   String       @map("prompt_name")
  variantA     Prompt       @relation("VariantA", fields: [variantAId], references: [id])
  variantAId   Int          @map("variant_a_id")
  variantB     Prompt       @relation("VariantB", fields: [variantBId], references: [id])
  variantBId   Int          @map("variant_b_id")
  splitPercent Int          @default(50) @map("split_percent")
  status       ABTestStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  endedAt      DateTime?    @map("ended_at")

  traces Trace[]

  // Serves the SDK's /api/ab-tests/active poll and the "is one already running
  // for this prompt?" check performed when a test is created.
  @@index([promptName, status])
  @@map("ab_tests")
}

model Trace {
  id               Int         @id @default(autoincrement())
  prompt           Prompt      @relation(fields: [promptId], references: [id])
  promptId         Int         @map("prompt_id")
  abTest           ABTest?     @relation(fields: [abTestId], references: [id])
  abTestId         Int?        @map("ab_test_id")
  variant          String?
  latencyMs        Int         @map("latency_ms")
  promptTokens     Int         @map("prompt_tokens")
  completionTokens Int         @map("completion_tokens")
  costUsd          Float       @map("cost_usd")
  /// True when costUsd was derived from fallback pricing because the model was
  /// not in the SDK's pricing table. Aggregates must surface this, otherwise a
  /// guessed cost is indistinguishable from a measured one.
  pricingUnknown   Boolean     @default(false) @map("pricing_unknown")
  status           TraceStatus
  /// Why the call failed. Null for successful calls. "Error rate: 5%" cannot be
  /// acted on without knowing whether it is throttling, an expired key or an
  /// upstream outage.
  errorType        TraceErrorType? @map("error_type")
  /// Client-generated id, echoed back to the host application so it can attach
  /// an outcome to this call later. Nullable: traces from SDK versions before
  /// outcomes existed do not have one.
  clientTraceId    String?     @unique @map("client_trace_id")
  /// Which of the three prompt sources this call used. Without it the tool
  /// cannot answer "did my release actually reach a client", which is the first
  /// question anyone asks after promoting one.
  promptSource     PromptSource? @map("prompt_source")
  /// The release being served, when promptSource is REGISTRY.
  release          PromptRelease? @relation(fields: [releaseId], references: [id])
  releaseId        Int?          @map("release_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([promptId, createdAt])
  @@index([abTestId])
  // The dashboard's rollup filters on created_at alone, which the composite
  // index above cannot serve.
  @@index([createdAt])
  // Serves the drill-down: newest calls for one prompt version. Without it that
  // query sequentially scanned the whole table and sorted, which is the very
  // problem keyset pagination was chosen to avoid.
  @@index([promptId, id])
  @@index([releaseId])
  @@map("traces")
}

/// A quality signal the host application reports after the fact — a thumbs-up,
/// a resolved ticket, a grader's rating.
///
/// Deliberately NOT a foreign key to Trace. An application typically knows the
/// outcome moments after the call, while the trace itself is buffered and
/// batched, so the outcome can legitimately arrive first. Keying both sides on
/// client_trace_id lets them land in either order and be joined afterwards.
///
/// Nothing here carries user content (ADR-2): a score is a number and a label
/// is a short tag, both length-checked at the API boundary.
model Outcome {
  id            Int      @id @default(autoincrement())
  clientTraceId String   @unique @map("client_trace_id")
  /// Normalised to 0..1 so variants stay comparable. Binary outcomes use 0 or 1.
  score         Float
  /// Optional short tag describing what was measured, e.g. "thumbs_up".
  label         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([label])
  @@map("outcomes")
}

/// An append-only log of which version of a prompt is served.
///
/// There is no `isCurrent` flag. The live release for a prompt is simply its
/// most recent row, which means the pointer can never drift out of sync with
/// the history, and a rollback is an ordinary insert rather than a mutation of
/// two rows that must agree.
///
/// Nothing here is required for PromptWatch to observe an application. A prompt
/// with no releases is served entirely from the caller's own code; a release
/// only overrides it for SDK instances that opted in (ADR-11).
model PromptRelease {
  id         Int           @id @default(autoincrement())
  promptName String        @map("prompt_name")
  prompt     Prompt        @relation(fields: [promptId], references: [id])
  promptId   Int           @map("prompt_id")
  source     ReleaseSource
  /// Free-text justification shown in the release history.
  reason     String?
  /// The test this decision came from, when it came from one.
  abTestId   Int?          @map("ab_test_id")
  /// Snapshot of the comparison at the moment of promotion, so the record still
  /// explains itself after the underlying traces have aged out (retention).
  evidence   Json?
  /// Self-declared name of whoever promoted this, captured by the dashboard.
  /// Attribution, not authentication - see ADR-13.
  actor      String?
  createdAt  DateTime      @default(now()) @map("created_at")

  traces     Trace[]

  // Serves "what is live for this prompt" — the SDK's poll and every UI badge.
  @@index([promptName, createdAt])
  @@map("prompt_releases")
}
